# 百度图像识别应用
BAIDU_DETECT_API_KEY=
BAIDU_DETECT_SECRET_KEY=

# 百度智能抠图应用
BAIDU_PROCESS_API_KEY=
BAIDU_PROCESS_SECRET_KEY=

# 阿里云百炼
DASHSCOPE_API_KEY=

# 函数计算中把 OSS Bucket 挂载到此目录
DATA_DIR=/mnt/oss/emoji-tasks

# 上线后填写前端和后端的 HTTPS 地址
CORS_ORIGINS=https://your-frontend.example.com
PUBLIC_BASE_URL=https://your-api.example.com
